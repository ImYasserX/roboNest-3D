# RoboNest.3D environment variables. COPY, never commit real values.
#
# Local development:
#   - Wrangler/workerd (npm run dev bindings, wrangler dev, E2E) read `.dev.vars`.
#   - `next dev` also falls back to `.env.local` for the variables read with
#     getServerVar() (src/server/env.ts).
# Production: set secrets with `npx wrangler secret put NAME`; non-secret
# values may go in wrangler.jsonc "vars". Never use a NEXT_PUBLIC_ prefix for these.

# --- Core (required) --------------------------------------------------------
APP_SECRET=                      # >= 32 random chars: openssl rand -base64 48
SITE_URL=http://localhost:3000   # production: https origin, no trailing slash (wrangler.jsonc vars)

# --- Contact form (Resend) ----------------------------------------------------
RESEND_API_KEY=                  # secret, from resend.com → API Keys
# Recipient. Already set in wrangler.jsonc vars; override only if needed.
CONTACT_FORM_EMAIL=contact@robonest.tech
# Sender, SEPARATE from the recipient, on a domain verified in Resend:
#   "RoboNest.3D <no-reply@robonest.tech>"  or  no-reply@robonest.tech
CONTACT_FROM_EMAIL=             # must differ from CONTACT_FORM_EMAIL; check with: npm run email:check

# --- Telegram order alerts ------------------------------------------------------
TELEGRAM_BOT_TOKEN=              # secret, from @BotFather
TELEGRAM_CHAT_IDS=               # both owners' chat ids, comma-separated (node scripts/telegram-chat-ids.mjs)

# --- Phone verification -----------------------------------------------------------
# Default channel: Twilio Verify SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=               # secret
TWILIO_VERIFY_SERVICE_SID=
# Optional, under evaluation: WhatsApp Cloud API (Meta) as the primary channel.
# Leave PHONE_VERIFICATION_PRIMARY unset (= sms) until WhatsApp is tested.
PHONE_VERIFICATION_PRIMARY=      # "whatsapp" or empty
WHATSAPP_ACCESS_TOKEN=           # secret: permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=        # WhatsApp Manager → Phone numbers (the ID, not the number)
WHATSAPP_GRAPH_API_VERSION=      # e.g. v23.0; use the version shown in your Meta app dashboard
WHATSAPP_OTP_TEMPLATE_NAME=      # approved AUTHENTICATION template with a copy-code button
WHATSAPP_OTP_TEMPLATE_LANGUAGE_AR=   # template language code as approved, e.g. ar
WHATSAPP_OTP_TEMPLATE_LANGUAGE_EN=   # e.g. en_US

# --- Online deposits (FIB): RETIRED 2026-10-12 --------------------------------------------
# Payments are confirmed manually by an Owner (docs/PAYMENTS.md). These are ignored
# by the app; kept only so old .dev.vars files stay documented. Leave them empty.
FIB_ONLINE_DEPOSITS=             # ignored
FIB_BASE_URL=                    # ignored
FIB_CLIENT_ID=                   # ignored
FIB_CLIENT_SECRET=               # ignored (secret)

# --- Safety ---------------------------------------------------------------------------
# "disabled" hides every provider credential above, so nothing is sent.
# E2E and Vitest always set it; add it to .dev.vars for quiet local work.
OUTBOUND_INTEGRATIONS=

# --- Build-time ------------------------------------------------------------------------
NEXT_PUBLIC_IMAGE_TRANSFORMS=    # "cloudflare" in production builds (not a secret)
